# Stripe (optional — without these the app runs in instant-settle demo mode)
# Use test keys (sk_test_...) until you are ready to charge real cards.
STRIPE_SECRET_KEY=
# Required in production: /api/webhook refuses unsigned events without it.
STRIPE_WEBHOOK_SECRET=

# Absolute origin used for Stripe success/cancel redirect URLs,
# e.g. https://amanah.example.com (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=
