# Stripe (test mode keys — https://dashboard.stripe.com/test/apikeys)
# Leave unset to run in local "demo mode": checkout completes instantly with
# no real Stripe call, so you can click through the whole flow offline.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (optional — only needed once you swap lib/db.ts for real
# persistence per schema.sql; the app runs fine without these using its
# built-in in-memory store).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
