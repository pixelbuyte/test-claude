# ── Stripe ─────────────────────────────────────────────────────────────
# Leave BOTH unset to run in demo mode: checkout settles instantly, nothing
# is charged, and the board resets on every redeploy.
#
#   sk_test_...  → test mode. Use card 4242 4242 4242 4242. No real money.
#   sk_live_...  → LIVE mode. Real cards are charged real money.
#
# The app reads the prefix and tells buyers which mode they're in, so don't
# mix a live key into a staging deployment.
STRIPE_SECRET_KEY=

# From the Stripe dashboard → Developers → Webhooks, after adding an endpoint
# for https://<your-domain>/api/webhook subscribed to checkout.session.completed.
# Required whenever STRIPE_SECRET_KEY is set: /api/webhook refuses to run
# without it, because that endpoint grants free placement on the board.
STRIPE_WEBHOOK_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────
# Gates writes to /admin (base prices, duration multipliers, steal premium,
# content filters). Fails CLOSED: if this is unset, nobody can change pricing.
ADMIN_PASSWORD=

# ── Supabase (optional) ────────────────────────────────────────────────
# Only needed once you swap lib/db.ts for real persistence per schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
